# Copy this file to .env. Never commit the real .env file.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=18080

# MySQL
MYSQL_DATABASE=cloudmind
MYSQL_USER=cloudmind
MYSQL_PASSWORD=replace_with_a_random_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_random_password
DB_URL=jdbc:mysql://localhost:3306/cloudmind?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai

# MinIO
MINIO_IMAGE=replace_with_a_reviewed_immutable_minio_compatible_image
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=replace_with_a_random_access_key
MINIO_ROOT_PASSWORD=replace_with_a_random_secret_key
MINIO_BUCKET=cloudmind

# The bootstrap account is created only when no user with this name exists.
# Use at least 14 characters. The administrator must change it after first login.
CLOUDMIND_BOOTSTRAP_ADMIN_USERNAME=
CLOUDMIND_BOOTSTRAP_ADMIN_PASSWORD=

# Production AI credentials must be injected by the deployment environment.
CLOUDMIND_AI_API_KEY=
# Required only when an administrator saves an AI Key in development.
# Generate a Base64-encoded random 32-byte key and store it outside Git.
CLOUDMIND_AI_CONFIG_ENCRYPTION_KEY=
CLOUDMIND_AI_ALLOWED_HOSTS=api.deepseek.com,api.openai.com

# Upload limits
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=100MB
MAX_FILE_BYTES=104857600
DEFAULT_QUOTA_BYTES=10737418240

# Session security
ACCESS_TOKEN_TTL=PT30M
REFRESH_TOKEN_TTL=P7D
TOKEN_CLEANUP_INTERVAL_MS=3600000
MAX_LOGIN_FAILURES=5
LOGIN_LOCK_DURATION=PT15M

# API rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_PASSWORD_CHANGE_PER_15_MINUTES=5
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=30
